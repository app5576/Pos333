<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MicroPOS" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryVariant">@color/colorPrimaryDark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/colorAccent</item>
        <item name="colorSecondaryVariant">@color/colorAccent</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
    </style>

    <style name="Theme.MicroPOS.Splash" parent="Theme.MicroPOS">
        <item name="android:windowBackground">@color/colorPrimary</item>
    </style>

    <style name="ThemeOverlay.AppCompat.Dark.ActionBar" parent="ThemeOverlay.MaterialComponents.Dark.ActionBar" />
    
    <!-- نمط موحد لأزرار التقارير -->
    <style name="ReportButtonStyle" parent="Widget.AppCompat.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:layout_marginBottom">6dp</item>
        <item name="android:padding">12dp</item>
        <item name="android:gravity">right|center_vertical</item>
        <item name="android:textAlignment">viewEnd</item>
        <item name="android:backgroundTint">#FFFFFF</item>
        <item name="android:textColor">#2C3E50</item>
        <item name="android:drawableEnd">@drawable/ic_chevron_left</item>
    </style>
</resources>