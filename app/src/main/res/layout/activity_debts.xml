<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <com.google.android.material.appbar.AppBarLayout android:layout_width="match_parent" android:layout_height="wrap_content">
        <androidx.appcompat.widget.Toolbar android:id="@+id/toolbar" android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize" app:title="كشف الديون المستحقة"/>
    </com.google.android.material.appbar.AppBarLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" app:layout_behavior="@string/appbar_scrolling_view_behavior">
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_margin="12dp"
            app:cardCornerRadius="12dp" app:cardElevation="4dp" app:cardBackgroundColor="#FFEBEE">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:padding="16dp" android:gravity="center">
                <TextView android:id="@+id/tv_total_debts" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="إجمالي الديون: 0.00 ر.س"
                    android:textSize="18sp" android:fontFamily="sans-serif-bold" android:textColor="#C62828"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.chip.ChipGroup android:id="@+id/chip_group_debt_filter"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="12dp" android:layout_marginBottom="8dp"
            app:singleSelection="true">
            <com.google.android.material.chip.Chip android:id="@+id/chip_all_debts"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="الكل" app:chipBackgroundColor="@color/colorPrimary" android:checked="true"
                style="@style/Widget.MaterialComponents.Chip.Filter"/>
            <com.google.android.material.chip.Chip android:id="@+id/chip_customer_debts"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="ديون العملاء" style="@style/Widget.MaterialComponents.Chip.Filter"/>
            <com.google.android.material.chip.Chip android:id="@+id/chip_supplier_debts"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="ديون الموردين" style="@style/Widget.MaterialComponents.Chip.Filter"/>
        </com.google.android.material.chip.ChipGroup>
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/rv_debts"
            android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" android:padding="8dp"/>
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
