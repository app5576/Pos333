<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="rtl">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:popupTheme="@style/ThemeOverlay.AppCompat.Light"/>
    </com.google.android.material.appbar.AppBarLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <EditText
            android:id="@+id/et_search_purchase"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="بحث عن منتج..."
            android:inputType="text"
            android:padding="10dp"
            android:layout_margin="8dp"
            android:background="@android:drawable/edit_text"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_purchase_products"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:padding="8dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#F5F5F5"
            android:padding="12dp">

            <TextView
                android:id="@+id/tv_purchase_count"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="عدد الأصناف: 0"
                android:textSize="14sp"/>

            <TextView
                android:id="@+id/tv_purchase_total"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="الإجمالي: 0.00 ر.س"
                android:textSize="14sp"
                android:textStyle="bold"
                android:gravity="end"/>
        </LinearLayout>

        <Button
            android:id="@+id/btn_confirm_purchase"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="تأكيد فاتورة الشراء"
            android:layout_margin="8dp"
            android:padding="14dp"
            android:textSize="16sp"/>
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
