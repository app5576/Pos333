<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#F5F5F5">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="12dp">

        <!-- Shift Card -->
        <com.google.android.material.card.MaterialCardView android:id="@+id/card_shift"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="12dp" app:cardCornerRadius="12dp"
            app:cardBackgroundColor="@color/colorPrimaryDark" app:cardElevation="4dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:padding="16dp" android:gravity="center_vertical">
                <TextView android:text="⏰" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="24sp" android:layout_marginEnd="12dp"/>
                <TextView android:id="@+id/tv_shift_status" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="لا توجد وردية مفتوحة" android:textColor="#FFFFFF"
                    android:textSize="14sp" android:fontFamily="sans-serif-medium"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Stats Row 1 -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginBottom="12dp">
            <com.google.android.material.card.MaterialCardView android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1"
                android:layout_marginEnd="6dp" app:cardCornerRadius="12dp" app:cardElevation="3dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="16dp">
                    <TextView android:text="مبيعات اليوم" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#757575"/>
                    <TextView android:id="@+id/tv_today_sales" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="0.00 ر.س"
                        android:textSize="18sp" android:textColor="#1565C0" android:fontFamily="sans-serif-bold"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1"
                android:layout_marginStart="6dp" app:cardCornerRadius="12dp" app:cardElevation="3dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="16dp">
                    <TextView android:text="فواتير اليوم" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#757575"/>
                    <TextView android:id="@+id/tv_today_invoices" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="0"
                        android:textSize="18sp" android:textColor="#2E7D32" android:fontFamily="sans-serif-bold"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- Stats Row 2 -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginBottom="12dp">
            <com.google.android.material.card.MaterialCardView android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1"
                android:layout_marginEnd="6dp" app:cardCornerRadius="12dp" app:cardElevation="3dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="16dp">
                    <TextView android:text="مبيعات الشهر" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#757575"/>
                    <TextView android:id="@+id/tv_month_sales" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="0.00 ر.س"
                        android:textSize="18sp" android:textColor="#6A1B9A" android:fontFamily="sans-serif-bold"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1"
                android:layout_marginStart="6dp" app:cardCornerRadius="12dp" app:cardElevation="3dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="16dp">
                    <TextView android:text="ديون مستحقة" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#757575"/>
                    <TextView android:id="@+id/tv_pending_debts" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="0.00 ر.س"
                        android:textSize="18sp" android:textColor="#C62828" android:fontFamily="sans-serif-bold"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- Stats Row 3 -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginBottom="16dp">
            <com.google.android.material.card.MaterialCardView android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1"
                android:layout_marginEnd="4dp" app:cardCornerRadius="12dp" app:cardElevation="3dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="12dp" android:gravity="center">
                    <TextView android:text="📦" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="22sp"/>
                    <TextView android:id="@+id/tv_total_products" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="0" android:textSize="16sp" android:fontFamily="sans-serif-bold"/>
                    <TextView android:text="منتج" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="#757575"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1"
                android:layout_marginStart="4dp" android:layout_marginEnd="4dp" app:cardCornerRadius="12dp" app:cardElevation="3dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="12dp" android:gravity="center">
                    <TextView android:text="⚠️" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="22sp"/>
                    <TextView android:id="@+id/tv_low_stock" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="0" android:textSize="16sp"
                        android:fontFamily="sans-serif-bold" android:textColor="#E53935"/>
                    <TextView android:text="نفاد مخزون" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="#757575"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1"
                android:layout_marginStart="4dp" app:cardCornerRadius="12dp" app:cardElevation="3dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="12dp" android:gravity="center">
                    <TextView android:text="👥" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="22sp"/>
                    <TextView android:id="@+id/tv_total_customers" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="0" android:textSize="16sp" android:fontFamily="sans-serif-bold"/>
                    <TextView android:text="عميل" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="#757575"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- Quick Actions -->
        <TextView android:text="الوصول السريع" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textSize="16sp"
            android:fontFamily="sans-serif-medium" android:layout_marginBottom="8dp"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginBottom="8dp">
            <com.google.android.material.button.MaterialButton android:id="@+id/btn_go_sales"
                android:layout_width="0dp" android:layout_height="80dp" android:layout_weight="1"
                android:layout_marginEnd="6dp" android:text="🛒\nمبيعات" android:textSize="12sp"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/btn_go_purchases"
                android:layout_width="0dp" android:layout_height="80dp" android:layout_weight="1"
                android:layout_marginEnd="6dp" android:text="🏪\nمشتريات" android:textSize="12sp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/btn_go_inventory"
                android:layout_width="0dp" android:layout_height="80dp" android:layout_weight="1"
                android:text="📦\nمخزون" android:textSize="12sp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginBottom="8dp">
            <com.google.android.material.button.MaterialButton android:id="@+id/btn_go_returns"
                android:layout_width="0dp" android:layout_height="80dp" android:layout_weight="1"
                android:layout_marginEnd="6dp" android:text="↩️\nمرتجعات" android:textSize="12sp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/btn_go_shifts"
                android:layout_width="0dp" android:layout_height="80dp" android:layout_weight="1"
                android:layout_marginEnd="6dp" android:text="⏰\nورديات" android:textSize="12sp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/btn_go_promotions"
                android:layout_width="0dp" android:layout_height="80dp" android:layout_weight="1"
                android:text="🏷️\nعروض" android:textSize="12sp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginBottom="16dp">
            <com.google.android.material.button.MaterialButton android:id="@+id/btn_go_customers"
                android:layout_width="0dp" android:layout_height="80dp" android:layout_weight="1"
                android:layout_marginEnd="6dp" android:text="👤\nعملاء" android:textSize="12sp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/btn_go_reports"
                android:layout_width="0dp" android:layout_height="80dp" android:layout_weight="1"
                android:layout_marginEnd="6dp" android:text="📊\nتقارير" android:textSize="12sp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/btn_go_employees"
                android:layout_width="0dp" android:layout_height="80dp" android:layout_weight="1"
                android:text="👨‍💼\nموظفون" android:textSize="12sp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
        </LinearLayout>
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_go_expenses"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="16dp" android:text="💰 المصاريف"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>

        <!-- Low Stock -->
        <TextView android:text="تنبيهات المخزون المنخفض" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textSize="16sp"
            android:fontFamily="sans-serif-medium" android:layout_marginBottom="8dp"/>
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/rv_low_stock"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"/>
    </LinearLayout>
</ScrollView>
