<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:layoutDirection="rtl">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="💳 إتمام عملية البيع" android:textSize="20sp" android:textStyle="bold"
            android:layout_marginBottom="16dp" android:textColor="@color/primary"/>

        <TextView android:id="@+id/tv_total_display" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="إجمالي الفاتورة: 0.00"
            android:textStyle="bold" android:textSize="16sp"/>
        <TextView android:id="@+id/tv_balance_display" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="المتبقي: 0.00"
            android:textColor="#E53935" android:layout_marginBottom="10dp"/>

        <RadioGroup android:id="@+id/rg_payment_type" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="horizontal">
            <RadioButton android:id="@+id/rb_cash" android:layout_width="0dp" android:layout_weight="1" android:text="نقدًا" android:checked="true"/>
            <RadioButton android:id="@+id/rb_card" android:layout_width="0dp" android:layout_weight="1" android:text="بطاقة"/>
            <RadioButton android:id="@+id/rb_credit" android:layout_width="0dp" android:layout_weight="1" android:text="آجل"/>
        </RadioGroup>

        <!-- 🆕 حقل كود الخصم -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="10dp">
            <EditText android:id="@+id/et_promo_code"
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:hint="🎟️ كود الخصم" android:inputType="text"/>
            <Button android:id="@+id/btn_apply_promo"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="تطبيق" android:layout_marginStart="8dp" android:backgroundTint="@color/primary"/>
        </LinearLayout>
        <TextView android:id="@+id/tv_promo_applied"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="" android:textColor="#388E3C" android:textStyle="bold"
            android:visibility="gone" android:layout_marginTop="4dp"/>

        <EditText android:id="@+id/et_discount" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:hint="الخصم"
            android:digits="0123456789." android:inputType="numberDecimal"
            android:layout_marginTop="8dp" android:text="0"/>

        <EditText android:id="@+id/et_paid_amount" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:hint="المبلغ المدفوع"
            android:digits="0123456789." android:inputType="numberDecimal"/>

        <AutoCompleteTextView android:id="@+id/actv_customer"
            android:layout_width="match_parent" android:layout_height="50dp"
            android:hint="اسم العميل" android:layout_marginTop="8dp"/>

        <!-- رصيد العميل السابق - يظهر فقط عند اختيار آجل وتحديد عميل -->
        <TextView android:id="@+id/tv_customer_balance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:padding="10dp"
            android:backgroundTint="#FFF3E0"
            android:background="@android:color/transparent"
            android:textColor="#E65100"
            android:textStyle="bold"
            android:textSize="14sp"
            android:visibility="gone"/>

        <EditText android:id="@+id/et_notes" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:hint="ملاحظات" android:inputType="textMultiLine"/>
    </LinearLayout>
</ScrollView>
